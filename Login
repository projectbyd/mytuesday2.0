<!DOCTYPE html>
<!--
  MY TUESDAY — Halaman Login
  ------------------------------------------------
  Halaman ini terpisah dari my-tuesday.html.
  Alurnya:
    1. Pengguna mengisi Nama & Email.
    2. Email dicocokkan dengan daftar di allowed-emails.js.
    3. Kalau cocok → data login disimpan di localStorage lalu
       diarahkan ke my-tuesday.html.
    4. Kalau tidak cocok → muncul pesan error, tidak bisa masuk.

  CATATAN PENTING:
  Ini adalah proteksi sisi-browser (client-side), bukan login server
  sungguhan. Cukup untuk mencegah orang random yang kebetulan tahu
  link, tapi bukan pengaman tingkat tinggi (orang yang paham teknis
  masih bisa melihat/mengubah kode lewat DevTools browser).
-->
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1">
<title>Masuk — My Tuesday</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500;1,9..144,600&family=Karla:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #F6F1EA;
    --paper-soft: #FBF8F4;
    --ink: #2D2438;
    --ink-mute: #7A7086;
    --line: #E4DACB;
    --accent: #C65A6B;
    --accent-soft: #C65A6B22;
  }

  * { box-sizing: border-box }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
  }

  body {
    background: var(--paper);
    color: var(--ink);
    font-family: Karla, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    -webkit-tap-highlight-color: transparent;
  }

  .login-card {
    width: 100%;
    max-width: 380px;
    background: var(--paper-soft);
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 34px 26px;
  }

  .eyebrow {
    font-size: 11px;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--ink-mute);
    font-weight: 700;
    margin: 0 0 8px;
    text-align: center;
  }

  h1 {
    font-family: Fraunces, serif;
    font-weight: 600;
    font-size: 28px;
    text-align: center;
    margin: 0 0 6px;
  }

  .sub {
    font-family: Fraunces, serif;
    font-style: italic;
    color: var(--ink-mute);
    text-align: center;
    margin: 0 0 28px;
    font-size: 14px;
  }

  label {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    margin: 0 0 6px;
  }

  input[type=text],
  input[type=email] {
    width: 100%;
    border: 1px solid var(--line);
    background: white;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 16px;
    color: var(--ink);
    font-family: inherit;
    margin-bottom: 16px;
  }

  input[type=text]:focus,
  input[type=email]:focus {
    outline: none;
    border-color: var(--accent);
  }

  .submit-btn {
    width: 100%;
    border: none;
    background: var(--ink);
    color: white;
    border-radius: 12px;
    padding: 13px;
    font-size: 14.5px;
    font-weight: 700;
    font-family: inherit;
    cursor: pointer;
    margin-top: 4px;
  }

  .submit-btn:active { opacity: .85 }

  .error-msg {
    display: none;
    background: var(--accent-soft);
    border: 1px solid var(--accent);
    color: #7A3A44;
    border-radius: 10px;
    padding: 10px 12px;
    font-size: 12.5px;
    line-height: 1.5;
    margin-bottom: 16px;
  }

  .error-msg.show { display: block }

  .note {
    text-align: center;
    color: var(--ink-mute);
    font-size: 11px;
    line-height: 1.5;
    margin: 18px 0 0;
  }
</style>
</head>
<body>

<div class="login-card">
  <p class="eyebrow">5 Tahun dari Sekarang</p>
  <h1>My Tuesday</h1>
  <p class="sub">Masuk dulu untuk membuka isi hatimu.</p>

  <div class="error-msg" id="errorMsg"></div>

  <form id="loginForm">
    <label for="nameInput">Nama</label>
    <input type="text" id="nameInput" placeholder="Nama kamu" autocomplete="name" required>

    <label for="emailInput">Email</label>
    <input type="email" id="emailInput" placeholder="email@contoh.com" autocomplete="email" required>

    <button type="submit" class="submit-btn">Masuk</button>
  </form>

  <p class="note">Hanya email yang sudah didaftarkan yang bisa masuk ke aplikasi ini.</p>
</div>

<!-- Daftar email diizinkan (diedit manual di GitHub) -->
<script src="allowed-emails.js"></script>

<script>
  const AUTH_KEY = 'mt_auth';

  // Kalau sudah pernah login & masih valid, langsung lempar ke aplikasi.
  (function autoRedirectIfLoggedIn() {
    try {
      const auth = JSON.parse(localStorage.getItem(AUTH_KEY) || 'null');
      if (auth && isAllowed(auth.email)) {
        window.location.href = 'my-tuesday.html';
      }
    } catch (e) {}
  })();

  function isAllowed(email) {
    email = (email || '').trim().toLowerCase();
    if (!email) return false;
    return (window.ALLOWED_EMAILS || []).some(
      e => e.trim().toLowerCase() === email
    );
  }

  function showError(msg) {
    const box = document.getElementById('errorMsg');
    box.textContent = msg;
    box.classList.add('show');
  }

  function hideError() {
    document.getElementById('errorMsg').classList.remove('show');
  }

  document.getElementById('loginForm').addEventListener('submit', function (e) {
    e.preventDefault();
    hideError();

    const name = document.getElementById('nameInput').value.trim();
    const email = document.getElementById('emailInput').value.trim();

    if (!name || !email) {
      showError('Nama dan email wajib diisi.');
      return;
    }

    if (!isAllowed(email)) {
      showError('Email ini belum terdaftar. Hubungi admin untuk didaftarkan.');
      return;
    }

    localStorage.setItem(AUTH_KEY, JSON.stringify({ name, email }));
    window.location.href = 'my-tuesday.html';
  });
</script>

</body>
</html>
